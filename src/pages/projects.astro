---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="ihor kalchenko | projects" description="Here are a few projects I've worked on recently" activeNav="projects">
  <section class="section">
    <header class="section-header">
      <h1 class="section-title">My recent work</h1>
      <p class="section-subtitle">Here are a few projects I've worked on recently</p>
    </header>
    <section class="section-content">
      <section class="work">
        <ul class="work-list">
          {sortedProjects.map((project) => (
              <li class="work-item work-item--glass">
                <a class="work-glass-link" href={project.data.link} target="_blank" rel="noopener noreferrer">
                  <div class="work-backdrop">
                    <img
                        class="work-pic"
                        src={project.data.thumbnail}
                        alt={project.data.alt || project.data.title}
                        loading="lazy"
                    />
                    <div class="work-vignette"></div>
                    <div class="work-quick-badge">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </div>
                  </div>

                  <div class="work-glass-dock">
                    <div class="work-dock-inner">
                      <h3 class="work-title">{project.data.title}</h3>
                      <p class="work-tech-inline">{project.data.stack}</p>
                    </div>
                  </div>
                </a>
              </li>
          ))}
        </ul>
      </section>
    </section>
  </section>
</BaseLayout>
